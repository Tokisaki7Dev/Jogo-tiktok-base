# Usuário da live do TikTok (com ou sem @)
TIKTOK_USERNAME=tokisaki7_

# Porta HTTP/WebSocket do backend
PORT=8080

# Opcionais (use se a VPS sofrer bloqueio ou se a live tiver restrição 18+)
# TIKTOK_SIGN_API_KEY=
# TIKTOK_SESSION_ID=
# TIKTOK_ROOM_ID=

# Configuração RTMP (Restream / TikTok) para transmissão direta da VPS (não suba sua chave real no GitHub!)
RTMP_URL=rtmp://live.restream.io/live
RTMP_STREAM_KEY=COLE_SUA_STREAM_KEY_AQUI
